# Copy to .env and load explicitly with: uv run --env-file .env python -m seo_reviewer run --review
SITE_URL=https://www.djangoproject.com
OPENAI_MODEL=gpt-6.1-terra
OPENAI_API_KEY=
# Optional; an empty value uses unauthenticated PSI requests where Google permits them.
PAGESPEED_API_KEY=
PAGESPEED_ENABLED=true
PAGESPEED_STRATEGIES=mobile,desktop
PAGESPEED_MAX_PAGES=3
# Optional bounds: read timeout >0..120 seconds, retries 0..2, score threshold 0<value<=100.
PAGESPEED_READ_TIMEOUT=60
PAGESPEED_RETRIES=1
PAGESPEED_POOR_SCORE=50
